# Copie para .env e ajuste conforme a VPS.
# Porta no host (vinculada só ao localhost — use Nginx Proxy Manager na frente).
HTTP_PORT=8080

# Obrigatórios em produção. Gere uma vez e mantenha persistente no .env da VPS.
# Não regenere a cada deploy, senão a chave admin e os tokens CSRF em uso mudam.
ADMIN_API_KEY=troque-por-um-valor-gerado-com-openssl-rand-hex-32
CSRF_SECRET=troque-por-um-valor-gerado-com-openssl-rand-hex-32

# Caminho no host para GeoLite2-City.mmdb (opcional; descomente o volume no compose).
# GEO_DB_HOST_PATH=./data/geo/GeoLite2-City.mmdb

# --- Acesso a Telemetria via GitHub OAuth ---
# Crie uma OAuth App em https://github.com/settings/developers
#   Homepage URL:              https://frameworknet.carminati.dev.br
#   Authorization callback URL: https://frameworknet.carminati.dev.br/login/github/callback
# O Client Secret NUNCA entra no git: ele mora so aqui, no .env da VPS (chmod 600).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Login(s) do GitHub autorizados a abrir a Telemetria, separados por virgula.
GITHUB_OAUTH_LOGINS_PERMITIDOS=carmipa

# --- Publicacao do dataset publico ---
# Token fine-grained com Contents:Read and write em UM unico repositorio.
GITHUB_DATASET_TOKEN=
GITHUB_DATASET_REPO=carmipa/framework-net-telemetry-dataset

# TELEMETRIA_DATASET_SALT nao existe mais de proposito. A sanitizacao vive dentro
# da aplicacao e usa pseudonimo sequencial por pacote: irreversivel por
# construcao, sem segredo para guardar, sem backup para perder. O script antigo
# scripts/exportar-dataset.sh ainda depende de um sal e, por isso, falha fechado.
