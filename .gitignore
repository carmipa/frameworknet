# Gradle
.gradle/
build/

# Eclipse
.project
.classpath
.settings/
bin/

# IntelliJ
.idea
*.ipr
*.iml
*.iws

# NetBeans
nb-configuration.xml

# Visual Studio Code
.vscode
.factorypath

# OSX
.DS_Store

# Vim
*.swp
*.swo

# patch
*.orig
*.rej

# Local environment e segredos.
# Regra: tudo que casa com .env* fica FORA do git; so o exemplo entra.
# O .env da VPS guarda ADMIN_API_KEY, CSRF_SECRET e o client secret do OAuth.
.env
.env.*
!.env.example
secrets.properties
application-secret.properties
application-local.properties
*.pem
*.p12
*.jks
*.pfx
*.key

# Dados locais do docker-compose.dev.yml
docker-data/

# Logs e telemetria gerados em runtime (manter estrutura da pasta)
logs/*
!logs/.gitkeep
build/test-logs/

# Plugin directory
/.quarkus/cli/plugins/
# TLS Certificates
.certs/

# Sanitizador de telemetria (Python)
scripts/__pycache__/
*.pyc

# Dataset gerado na VPS — sai daqui para o repositório próprio do dataset,
# nunca versionado junto com a aplicação.
dataset/

# Saida da varredura de UI: derivada do codigo (inventario) e da execucao
# (relatorio). Versionar o inventario faria a lista envelhecer em silencio —
# ele tem de ser reextraido do codigo a cada varredura, nunca lido do git.
scripts/inventario.json
scripts/relatorio-varredura.txt

# Screenshots gerados pelos scripts de captura/validacao (Playwright): artefatos
# de execucao, reproduziveis a partir do codigo; nao versionar.
screenshots/

# Anotacoes locais das sessoes de trabalho com IA (checkpoint de continuidade):
# ficam so na maquina do autor; o repositorio e publico.
.claude/

# Dependencias do Playwright dos roteiros de navegador: reinstalar com "npm ci" em scripts/ (OPS-19).
scripts/node_modules/
scripts/vendor-globo/node_modules/

# Artefatos locais de assistentes de IA: ficam so na maquina, nunca no repositorio.
.codex/
.gemini/
.cursor/
.windsurf/
.continue/
.aider*
